{
  "name": "netmanage",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "dev:clean": "node scripts/dev-clean.mjs",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:push": "node --env-file=.env ./node_modules/drizzle-kit/bin.cjs push",
    "db:generate:pg": "node --env-file=.env ./node_modules/drizzle-kit/bin.cjs generate --config=drizzle.config.postgres.ts",
    "db:migrate:pg": "node --env-file=.env ./node_modules/drizzle-kit/bin.cjs migrate --config=drizzle.config.postgres.ts",
    "db:migrate-sqlite-to-pg": "node --env-file=.env --import tsx scripts/migrate-sqlite-to-pg.ts",
    "db:ensure-schema": "node --env-file=.env --import tsx src/lib/db/ensure-schema.ts",
    "uploads:ensure-dirs": "node --import tsx scripts/ensure-upload-dirs.ts",
    "db:migrate-tagihan": "node --env-file=.env --import tsx scripts/migrate-invoice-to-tagihan.ts",
    "db:seed": "node --env-file=.env --import tsx src/lib/db/seed.ts",
    "db:backfill-integrations": "node --env-file=.env --import tsx src/lib/db/backfill-tenant-integrations.ts",
    "db:sync-duitku-env": "node --env-file=.env --import tsx src/lib/db/sync-duitku-from-env.ts",
    "db:purge-duitku-sandbox": "node --env-file=.env --import tsx src/lib/db/purge-duitku-sandbox.ts",
    "backup:tenant": "node --env-file=.env --import tsx scripts/backup-tenant.ts",
    "backup:full": "node --env-file=.env --import tsx scripts/backup-full.ts",
    "backup:zip": "node --env-file=.env --import tsx scripts/backup-zip.ts",
    "deploy:app": "node --env-file=.env --import tsx scripts/deploy-app.ts",
    "messages:batch": "node --env-file=.env --import tsx scripts/send-message-batch.ts",
    "queue:worker": "node --env-file=.env --import ./scripts/register-server-only-stub.mjs --import tsx scripts/queue-worker.ts",
    "queue:failed": "node --env-file=.env --import tsx scripts/queue-failed.ts",
    "map:cache-test": "node --env-file=.env --import tsx scripts/map-cache-load-test.ts",
    "mobile:admin:sync": "npm run sync --prefix mobile/admin",
    "mobile:portal:sync": "npm run sync --prefix mobile/portal",
    "mobile:admin:open": "npm run open --prefix mobile/admin",
    "mobile:portal:open": "npm run open --prefix mobile/portal",
    "mobile:sync": "npm run mobile:admin:sync && npm run mobile:portal:sync",
    "mobile:assets": "node scripts/generate-mobile-assets.mjs",
    "mobile:assets:generate": "npm run assets:generate --prefix mobile/admin && npm run assets:generate --prefix mobile/portal",
    "mobile:apk": "node scripts/build-mobile-apk.mjs",
    "mobile:apk:debug": "node scripts/build-mobile-apk.mjs --debug",
    "mobile:portal:dev": "node scripts/mobile-dev.mjs --portal",
    "mobile:admin:dev": "node scripts/mobile-dev.mjs --admin",
    "mobile:dev": "node scripts/mobile-dev.mjs --portal"
  },
  "dependencies": {
    "@capacitor/app": "^7.1.2",
    "@capacitor/browser": "^7.0.5",
    "@capacitor/core": "^7.6.8",
    "@capacitor/filesystem": "^7.1.8",
    "@capacitor/share": "^7.0.4",
    "@types/leaflet": "^1.9.21",
    "@types/leaflet.markercluster": "^1.5.6",
    "better-sqlite3": "^12.11.1",
    "bullmq": "^5.79.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "google-auth-library": "^10.9.0",
    "html2canvas": "^1.4.1",
    "ioredis": "^5.11.1",
    "jspdf": "^4.2.1",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "lucide-react": "^1.20.0",
    "next": "^16.2.9",
    "node-routeros": "^1.6.8",
    "postgres": "^3.4.9",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0",
    "tsx": "^4.22.4",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.9.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "drizzle-kit": "^0.31.10",
    "postcss": "^8.5.15",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.3.1",
    "typescript": "^6.0.3"
  }
}
