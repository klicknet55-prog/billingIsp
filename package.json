{
  "name": "netmanage",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "dev:clean": "node -e \"require('fs').rmSync('.next',{recursive:true,force:true})\" && next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:push": "node --env-file=.env ./node_modules/drizzle-kit/bin.cjs push",
    "db:ensure-schema": "node --env-file=.env --import tsx src/lib/db/ensure-schema.ts",
    "db:migrate-tagihan": "node --env-file=.env --import tsx scripts/migrate-invoice-to-tagihan.ts",
    "db:seed": "node --env-file=.env --import tsx src/lib/db/seed.ts",
    "db:backfill-integrations": "node --env-file=.env --import tsx src/lib/db/backfill-tenant-integrations.ts",
    "backup:tenant": "node --env-file=.env --import tsx scripts/backup-tenant.ts",
    "backup:full": "node --env-file=.env --import tsx scripts/backup-full.ts",
    "deploy:app": "node --env-file=.env --import tsx scripts/deploy-app.ts",
    "messages:batch": "node --env-file=.env --import tsx scripts/send-message-batch.ts"
  },
  "dependencies": {
    "@types/leaflet": "^1.9.21",
    "@types/leaflet.markercluster": "^1.5.6",
    "better-sqlite3": "^12.11.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "lucide-react": "^1.20.0",
    "next": "^16.2.9",
    "node-routeros": "^1.6.8",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0",
    "tsx": "^4.22.4",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.9.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "drizzle-kit": "^0.31.10",
    "postcss": "^8.5.15",
    "tailwindcss": "^4.3.1",
    "typescript": "^6.0.3"
  }
}
