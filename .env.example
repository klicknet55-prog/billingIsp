# URL publik aplikasi (untuk footer copyright & return URL Duitku). Contoh: https://isp.tunnelhost.my.id
NEXT_PUBLIC_APP_URL=
# Daftar layanan TunnelHost (tombol di Integrasi & Router). Default: https://vpn.tunnelhost.my.id/
NEXT_PUBLIC_TUNNELHOST_WA_REGISTER_URL=
NEXT_PUBLIC_TUNNELHOST_MIKROTIK_VPN_URL=

# ----- Core (PostgreSQL) -----
DATABASE_DRIVER=postgres
DATABASE_URL=postgresql://netmanage:PASSWORD@localhost:5432/netmanage
# Jika password ada @ : / # ? — encode: @ → %40, : → %3A
# DATABASE_POOL_MAX=10
#
# SQLite hanya untuk dev lokal — jangan dipakai di production Postgres:
# DATABASE_DRIVER=sqlite
# DATABASE_URL=./netmanage.db
# Secret untuk menandatangani session cookie. WAJIB diganti di production.
AUTH_SECRET=change-this-to-a-long-random-string
# Secret untuk melindungi endpoint cron (/api/cron). Opsional di dev.
CRON_SECRET=
# Zona waktu operasional billing & tampilan tanggal (IANA). Default: Asia/Jakarta (WIB).
APP_TIMEZONE=Asia/Jakarta
NEXT_PUBLIC_APP_TIMEZONE=Asia/Jakarta
# Hari sebelum jatuh tempo untuk kirim reminder WhatsApp (default: 3).
BILLING_REMINDER_DAYS=3
# Tagihan pertama dapat dibayar D+N hari setelah tanggal pendaftaran pelanggan (default: 5).
BILLING_FIRST_INVOICE_DAYS=5
# Jendela generate tagihan recurring H-N sebelum jatuh tempo (default: 5).
BILLING_GENERATE_DAYS=5
# Grace isolir Mikrotik H+N setelah jatuh tempo (default: 7).
BILLING_ISOLATION_DAYS=7
# Dunning step 2 — pengingat WA H+N setelah jatuh tempo (default: 3).
BILLING_DUNNING_STEP2_DAYS=3
# Masa berlaku link bayar auto-login portal dari WhatsApp (default: 14 hari).
PORTAL_MAGIC_LINK_DAYS=14
# Panjang kode link bayar pendek /p/{code} (default 7, min 6 max 12)
# PORTAL_ACCESS_CODE_LENGTH=7

# ----- Mobile APK (MyWiFi App Links) -----
# SHA-256 fingerprint sertifikat release APK (pisah koma jika banyak). Wajib untuk verifikasi App Links.
# Dapatkan: keytool -list -v -keystore mobile/portal/android/netmanage-release.jks -alias netmanage
# ANDROID_APP_LINK_SHA256=AA:BB:CC:...
# FCM HTTP v1 (Legacy API sudah dinonaktifkan di Firebase — wajib service account)
# Buat di Firebase Console → Project Settings → Service accounts → Generate new private key
# Opsi A — path file JSON di server (jangan commit):
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/firebase-service-account.json
# Opsi B — inline (untuk PM2; private key pakai \n untuk newline):
# FCM_PROJECT_ID=your-firebase-project-id
# FCM_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# FCM_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Opsi C — satu baris JSON:
# FCM_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# Aktifkan push di APK Capacitor (wajib google-services.json di mobile/*/android/app/)
# NEXT_PUBLIC_MOBILE_PUSH_ENABLED=true

# ----- REST API v1 (Fase 6a) -----
# Rate limit per API key (default: 60 req/menit)
API_RATE_LIMIT_PER_MIN=60

# ----- Job queue (Fase 6c — BullMQ + Redis) -----
# Kosongkan REDIS_URL = inline/spawn fallback (dev). Production: pasang Redis + worker PM2.
# REDIS_URL=redis://127.0.0.1:6379
# QUEUE_DRIVER=redis
# QUEUE_CONCURRENCY=5
# QUEUE_MAX_RETRIES=3

# ----- Driver Integrasi (mock | real) -----
# Saat "mock", aplikasi berjalan penuh tanpa kredensial eksternal.
# Saat "real", prioritas credential: konfigurasi tenant di DB -> fallback ENV global ini.
MIKROTIK_DRIVER=mock
# Izinkan sertifikat HTTPS self-signed RouterOS (REST API). Setting platform, bukan per-router.
MIKROTIK_TLS_INSECURE=true
# Kredensial router per tenant: ISP → Router (tidak lewat .env).
DUITKU_DRIVER=mock
WHATSAPP_DRIVER=mock
MAPS_DRIVER=mock

# ----- VPN Mikrotik (platform — L2TP + port forward NAT) -----
VPN_DRIVER=mock
# VPN_API_BASE_URL=http://116.251.216.196:8080
# VPN_API_USERNAME=
# VPN_API_PASSWORD=
# IP/domain publik untuk billing → Mikrotik via NAT
# VPN_API_PUBLIC_HOST=
# VPN_IP_POOL_START=10.10.10.10
# VPN_IP_POOL_END=10.10.10.250
# VPN_LISTEN_PORT_START=18000

# ----- Duitku (diisi saat DUITKU_DRIVER=real) -----
DUITKU_MERCHANT_CODE=
DUITKU_API_KEY=
DUITKU_CALLBACK_URL=
# Opsional: override return URL browser setelah bayar (default: origin callback + /bayar/selesai)
DUITKU_RETURN_URL=
# Opsional: override endpoint inquiry (default production). Sandbox:
# https://sandbox.duitku.com/webapi/api/merchant/v2/inquiry
DUITKU_INQUIRY_URL=
# Opsional: kode metode pembayaran (contoh umum: VC, SP, QR).
DUITKU_PAYMENT_METHOD=VC

# ----- Klicknet / GOWA (provider Klicknet di Integrasi) -----
# URL server Go-WA — HARUS bisa di-resolve DNS dari mesin server billing (bukan placeholder)
# Contoh: https://103.x.x.x:3000 atau https://wa-anda.tunnelhost.my.id
KLICKNET_WA_BASE_URL=https://gowa.example.com
# Basic Auth server GOWA (username + password)
KLICKNET_WA_BASIC_USER=admin
KLICKNET_WA_BASIC_PASSWORD=

# ----- WhatsApp Business API / WABA (provider WABA di Integrasi) -----
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=

# ----- Email (welcome & reset password; mock | smtp) -----
EMAIL_DRIVER=mock
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ----- Google Maps (diisi saat MAPS_DRIVER=real) -----
NEXT_PUBLIC_MAPS_API_KEY=

# ----- Peta ISP (Leaflet + OSM, bukan Google Maps JS API) -----
NEXT_PUBLIC_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_MODEM_CACHE_SECONDS=180
# Cache modem shared antar instance PM2 jika REDIS_URL aktif (Fase 6d). Tanpa Redis = in-memory per proses.

# ----- Deploy dari dashboard superadmin (production only) -----
# Aktifkan tombol Update Aplikasi di /superadmin/deploy
DEPLOY_ENABLED=false
# Branch yang di-pull saat deploy (default: branch git saat ini)
DEPLOY_GIT_BRANCH=netmanage-implementation
# Nama app PM2 yang di-restart setelah build
DEPLOY_PM2_APP=billingisp
# Worker queue (opsional). Kosong + REDIS_URL aktif = restart billingisp-worker otomatis.
# DEPLOY_PM2_WORKER_APP=billingisp-worker

# ----- Throttle kirim WhatsApp -----
WA_SEND_DELAY_MIN_MS=1000
WA_SEND_DELAY_MAX_MS=3000
WA_SEND_BATCH_SIZE=10
WA_SEND_BATCH_PAUSE_MS=30000
